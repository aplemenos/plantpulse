from collections.abc import Iterable

import numpy as np
from numpy.typing import NDArray

class TextEmbedding:
    def __init__(self, model_name: str = ..., cache_dir: str | None = ...) -> None: ...
    def embed(self, documents: str | Iterable[str]) -> Iterable[NDArray[np.float32]]: ...
    def query_embed(self, query: str | Iterable[str]) -> Iterable[NDArray[np.float32]]: ...
    def passage_embed(self, texts: Iterable[str]) -> Iterable[NDArray[np.float32]]: ...
