# Minimal stubs for the faiss-cpu functions PlantPulse uses (faiss ships no types).
import numpy as np
from numpy.typing import NDArray

class Index:
    ntotal: int
    d: int
    def add(self, x: NDArray[np.float32]) -> None: ...
    def search(self, x: NDArray[np.float32], k: int) -> tuple[NDArray[np.float32], NDArray[np.int64]]: ...

class IndexFlatIP(Index):
    def __init__(self, d: int) -> None: ...

def normalize_L2(x: NDArray[np.float32]) -> None: ...
def write_index(index: Index, fname: str) -> None: ...
def read_index(fname: str) -> Index: ...
