from typing import Literal

from sklearn._typing import VectorLike

def precision_score(y_true: VectorLike, y_pred: VectorLike, *, zero_division: float | Literal["warn"] = ...) -> float: ...
def recall_score(y_true: VectorLike, y_pred: VectorLike, *, zero_division: float | Literal["warn"] = ...) -> float: ...
def f1_score(y_true: VectorLike, y_pred: VectorLike, *, zero_division: float | Literal["warn"] = ...) -> float: ...
def roc_auc_score(y_true: VectorLike, y_score: VectorLike) -> float: ...
def mean_absolute_error(y_true: VectorLike, y_pred: VectorLike) -> float: ...
